MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_PASSWORD=replace-with-a-different-long-random-app-password
BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-plus-character-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
SESSION_COOKIE_SECURE=false
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
IMAGE_TAG=master
# Sentry：留空则本地不上报；生产填项目 Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=

